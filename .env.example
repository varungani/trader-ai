# ===========================================
# TraderAI Configuration
# Copy to .env and fill in values you need
# ===========================================

# Monthly SIP (raise these later when income grows)
MONTHLY_STOCK_BUDGET=10000
MONTHLY_MF_BUDGET=10000
MAX_NEW_STOCKS_PER_MONTH=4
MIN_STOCK_TICKET=1500
MAX_PCT_PER_NAME_MONTHLY=0.35

# Universe scan — not limited to Nifty 50
# nifty50 | nifty100 | midcap | extended | all
UNIVERSE_PRESET=extended
SCREEN_TOP_N=20

# Optional: Finnhub free key (RSS works without this)
FINNHUB_API_KEY=

# Cloud LLM APIs (no local Ollama needed! Pick one):
# Option 1: Free Google AI Studio API key
GEMINI_API_KEY=
# Option 2: Free ultra-fast Groq API key
GROQ_API_KEY=
# Option 3: OpenAI or OpenRouter key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM backend: auto | gemini | groq | openai | ollama
LLM_BACKEND=auto
LLM_ANALYST_MODEL=
LLM_JUDGE_MODEL=
LLM_JUDGE_MIN_SCORE=55
LLM_JUDGE_BLOCK_ON_FAIL=true
LLM_MAX_REVIEW=6

# Paper week — keep real money OFF until week PASSES
REAL_MONEY_ENABLED=false
PAPER_WEEK_DAYS=7
PAPER_WEEK_MIN_TRUST=60
PAPER_WEEK_MIN_TRADES=3

# Kotak Neo Broker (READ-ONLY)
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=
KOTAK_MOBILE=+91XXXXXXXXXX
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=

# Mutual Fund Scheme Codes (AMFI) — split MF SIP across these
MF_SCHEME_CODES=119598,120503,135781

# Telegram Active Bot & Real-Time Alerts (for phone updates while in office)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_CHECK_INTERVAL_MINS=15

# WhatsApp Real-Time Alerts (Open-Source CallMeBot or Webhook)
# 1. Save +34 644 68 83 23 in contacts and WhatsApp: "I allow callmebot to send me messages"
# 2. Receive your apikey in 5 seconds and paste here:
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=callmebot
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
# Optional: Self-hosted open-source webhook gateway (e.g. Evolution API / Baileys)
WHATSAPP_WEBHOOK_URL=
# Optional: Twilio WhatsApp Cloud API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
